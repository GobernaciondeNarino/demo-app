# Solo multimedia: nunca ejecutar scripts subidos a esta carpeta.
Options -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
