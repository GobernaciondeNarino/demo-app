# Copie este archivo como .env SOLO si prefiere definir el administrador aquí
# en lugar de usar el código de instalación del panel. El .env está bloqueado
# por .htaccess / web.config, pero lo más seguro es borrar ADMIN_PASSWORD
# después de la primera ejecución.

ADMIN_USER=
ADMIN_PASSWORD=

# Opcional: llave maestra de 32 bytes (64 caracteres hex o base64) para cifrar
# las llaves API y la sesión. Si se deja vacía, se genera una automáticamente
# en wj-content/data/keys.php. Si la cambia, deberá volver a pegar las llaves API.
ENCRYPTION_KEY=
